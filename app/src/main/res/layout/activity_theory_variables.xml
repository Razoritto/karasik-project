<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgound_color"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/navPanel">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/blue_border_bott">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="130dp"
                        android:src="@drawable/ava"
                        android:layout_gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PythonMentor"
                        android:textSize="25sp"
                        android:textColor="@color/text_color"
                        android:gravity="center"
                        android:textStyle="bold"/>

                    <Space
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Что запускает наш код?"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Интерпретатор — это программа,
    которая построчно преобразует текст
    программы, написанной человеком, в
    программу на машинном языке,
    «понятную» компьютеру, и сразу
    выполняет указанные действия."
                        android:padding="20dp"
                        android:textColor="@color/text_color"/>

                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/border"
                android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Переменная"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Переменная - именованная область памяти для хранения и доступа к данным"
                        android:padding="20dp"
                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"
                        android:textColor="@color/text_color"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Запомните"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Переменная = имя + значение"
                        android:padding="20dp"
                        android:gravity="center"
                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"
                        android:textColor="@color/text_color"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Как создать?"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/variable2"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Пример создания"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/variables_example"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Ввод переменной с клавиатуры"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border"
                        android:orientation="vertical">

                        <!-- Строка 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/border"
                                android:text="n = int(input())"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ввод целого числа"
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/border"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="d = float(input())"
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ввод дробного числа"
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="s = input()"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ввод строки"
                                android:padding="12dp"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>



                    </LinearLayout>




                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/border"
                    android:layout_margin="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Вывод переменных на экран"
                        android:textStyle="bold"
                        android:textColor="@color/text_color"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:padding="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border"
                        android:orientation="vertical">

                        <!-- Строка 1: Простой вывод -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/border"
                                android:text="print(n)"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Вывод значения переменной"
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 2: Вывод текста -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/border"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text='print("Hello")'
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Вывод текста"
                                android:background="@drawable/border"
                                android:padding="12dp"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 3: Вывод нескольких значений -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="print(n, d, s)"
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Вывод нескольких значений"
                                android:padding="12dp"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 4: Форматированный вывод -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text='print(f"n={n}")'
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Форматированный вывод"
                                android:padding="12dp"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 5: Вывод с разделителем -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text='print(n, d, sep=", ")'
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Вывод с разделителем"
                                android:padding="12dp"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                        <!-- Строка 6: Вывод без перевода строки -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/border"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text='print(n, end=" ")'
                                android:padding="12dp"
                                android:fontFamily="monospace"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Вывод без перевода строки"
                                android:padding="12dp"
                                android:background="@drawable/border"
                                android:textColor="@color/text_color"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <com.example.karasik_project.ContactFooterView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"/>


            </LinearLayout>

        </ScrollView>


        <com.example.karasik_project.BottomNavigationPanel
            android:id="@+id/navPanel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>